{
  "name": "@apc/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Project Console desktop app",
  "author": "APC",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "qa": "pnpm qa:fixture && pnpm qa:electron",
    "qa:fixture:serve": "vite --config e2e/vite.fixture.config.ts",
    "qa:fixture": "playwright test -c e2e/playwright.fixture.config.ts",
    "qa:fixture:update": "playwright test -c e2e/playwright.fixture.config.ts --update-snapshots",
    "qa:electron": "pnpm build && playwright test -c e2e/playwright.electron.config.ts",
    "rebuild": "electron-rebuild -f -o better-sqlite3",
    "rebuild:pty": "electron-rebuild -f -o @homebridge/node-pty-prebuilt-multiarch",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "better-sqlite3": "^11.1.2",
    "bindings": "^1.5.0",
    "file-uri-to-path": "1.0.0"
  },
  "devDependencies": {
    "@apc/shared": "workspace:*", "@apc/core": "workspace:*", "@apc/pm": "workspace:*",
    "@apc/dashboard-api": "workspace:*", "@apc/app-services": "workspace:*", "@apc/agents": "workspace:*",
    "@apc/search": "workspace:*", "@apc/vault": "workspace:*", "@apc/llm-wiki": "workspace:*", "@apc/harness": "workspace:*", "@apc/knowledge-harness": "workspace:*", "@apc/knowledge": "workspace:*",
    "@apc/graph-view": "workspace:*",
    "react": "^18.3.1", "react-dom": "^18.3.1", "zustand": "^4.5.0",
    "@xterm/xterm": "^5.5.0", "@xterm/addon-fit": "^0.10.0", "@xterm/addon-unicode11": "0.8.0", "cytoscape": "^3.28.1",
    "electron": "^31.0.0", "electron-vite": "^2.3.0", "@electron/rebuild": "^3.6.0", "electron-builder": "^25.1.8",
    "@playwright/test": "^1.61.1", "vite": "^5.4.21",
    "@vitejs/plugin-react": "^4.3.1", "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.3", "@types/react-dom": "^18.3.0", "jsdom": "^24.1.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}

{
  "name": "agent-project-console",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p apps/desktop/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "qa": "pnpm qa:fixture && pnpm qa:electron",
    "qa:fixture": "pnpm --filter @apc/desktop qa:fixture",
    "qa:fixture:update": "pnpm --filter @apc/desktop qa:fixture:update",
    "qa:electron": "pnpm --filter @apc/desktop qa:electron",
    "graph-web": "node scripts/graph-web.mjs",
    "status-web": "node scripts/status-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rollup/rollup-linux-x64-gnu": "^4.62.0"
  }
}

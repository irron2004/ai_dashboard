# Flat (npm-like) node_modules layout.
# Native modules (better-sqlite3, node-pty) + node-gyp + electron-rebuild break on
# Windows with pnpm's default nested .pnpm symlink layout (node-addon-api .vcxproj.filters
# path errors). Hoisting fixes that and is harmless for the pure-JS engine packages.
node-linker=hoisted

# @electron/rebuild (3.7.x) pulls @electron/node-gyp from a git repository, which pnpm 11
# blocks as an "exotic subdep" by default. Allow it so electron-rebuild can install.
block-exotic-subdeps=false
